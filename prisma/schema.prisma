generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth_schema"]
}

enum Role {
  INVITADO
  ESTUDIANTE
  DOCENTE
  ENTRENADOR
  MODERADOR
  ADMIN

  @@schema("auth_schema")
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  passwordHash    String       @map("password_hash")
  isEmailVerified Boolean      @default(false) @map("is_email_verified")
  role            Role         @default(ESTUDIANTE)
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  profile         UserProfile?
  auditLogs       AuditLog[]

  @@map("users")
  @@schema("auth_schema")
}

model UserProfile {
  userId                 String   @id @map("user_id")
  fullName               String   @map("full_name")
  facultyId              String?  @map("faculty_id")
  academicProgram        String?  @map("academic_program")
  interests              String[] @default([])
  avatarUrl              String?  @map("avatar_url")
  isAuthorizedOrganizer  Boolean  @default(false) @map("is_authorized_organizer")
  habeasDataAcceptedAt   DateTime @default(now()) @map("habeas_data_accepted_at")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
  @@schema("auth_schema")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String   @map("actor_id")
  action       String
  targetEntity String   @map("target_entity")
  targetId     String   @map("target_id")
  payload      Json?
  ipAddress    String   @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetEntity, targetId])
  @@map("audit_logs")
  @@schema("auth_schema")
}
